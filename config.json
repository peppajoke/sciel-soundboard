{
  "outputs": [
    "Speakers (Realtek(R) Audio)"
  ],
  "master_gain": 1.0,
  "allow_overlap": false,
  "listen": {
    "inputs": [
      {
        "device": null,
        "loopback": true
      },
      {
        "device": "Microphone (NVIDIA Broadcast)",
        "loopback": false
      }
    ],
    "model": "small.en",
    "compute_type": "float16",
