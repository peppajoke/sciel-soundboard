  "auto_enabled": false,
  "random": {
    "enabled": false,
    "min_minutes": 4.0,
    "max_minutes": 8.0,
    "use_budget": true
  },
  "nas_inbox": "//192.168.1.169/media/soundboard/inbox",
  "nas_poll_s": 20,
  "port": 8770
